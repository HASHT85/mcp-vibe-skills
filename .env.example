# ============================================================
# VEIST — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================
# ⚠️  Ne JAMAIS commiter le fichier .env réel (il est dans .gitignore)

# ─── OBLIGATOIRES ─────────────────────────────────────────

# Clé OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mot de passe admin — dérive la clé AES-256 pour les secrets chiffrés
# Choisir une valeur longue et aléatoire (min 20 caractères)
ADMIN_PASS=changeme_choose_a_strong_password_here

# ─── OPTIONNELS AVEC DÉFAUT ───────────────────────────────

# Modèle LLM par défaut
# Exemples : google/gemini-2.5-flash | deepseek/deepseek-chat | openai/gpt-4o
AI_MODEL=anthropic/claude-sonnet-4

# Port du serveur Express
PORT=3000

# Budget tokens max par run agent (0 = illimité)
MAX_TOKENS_PER_AGENT=0

# Chemin du store de données principal
STORE_PATH=/data/store.json

# ─── FONCTIONNALITÉS OPTIONNELLES ─────────────────────────

# Tavily — requis pour l'outil web_search dans les agents
# https://tavily.com → Get API Key
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub PAT — requis pour créer des repos automatiquement
# https://github.com/settings/tokens → New token (classic) → scope: repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=ton_username_github

# Hostinger API — requis pour le déploiement automatique via quickDeploy
# https://hpanel.hostinger.com → API → Generate Token
HOSTINGER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HOSTINGER_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chemin absolu sur l'hôte pour le workspace (nécessaire pour auto-deploy Docker)
HOST_WORKSPACE_PATH=/opt/veist/workspace

# ─── DÉVELOPPEMENT LOCAL ──────────────────────────────────

NODE_ENV=development
