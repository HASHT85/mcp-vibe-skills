HOST_WORKSPACE_PATH=/opt/veist/workspace
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxx_A_REMPLIR_xxxx
HOSTINGER_API_TOKEN=your_hostinger_api_token
